{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@constant/*": ["src/constant/*"],
      "@navigation/*": ["src/navigation/*"],
      "@container/*": ["src/container/*"],
      "@rtkServices/*": ["src/rtkServices/*"],
      "@socket/*": ["src/socket/*"],
      "@store/*": ["src/store/*"],
      "@translation/*": ["src/translation/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@hooks/*": ["src/hooks/*"]
    }
  }
}
